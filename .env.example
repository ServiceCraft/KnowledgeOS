# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=knowledgeos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=knowledgeos

# App
APP_PROFILE=local
JWT_SECRET=changeme-jwt-secret-at-least-32-chars
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme

# Sync Agent (only needed with --profile sync)
CLOUD_API_URL=https://cloud.knowledgeos.example.com/api/v1
CLOUD_API_KEY=kos_live_changeme
SYNC_INTERVAL_SECONDS=60

# Backup snapshot endpoint (main app). Bearer key for GET /api/v1/backup/snapshot.
# Leave empty to disable the endpoint (returns 503). Rotate/revoke by changing
# this value — it is read per-request, no app restart required.
BACKUP_API_KEY=changeme
# Optional: commit hash baked into snapshot metadata. Set when building, e.g.
#   GIT_COMMIT=$(git rev-parse HEAD) docker compose up --build -d
GIT_COMMIT=

# Backup service (only needed with --profile backup, or when deployed standalone)
# APP_URL must point at the app over HTTPS in production (TLS terminated by Nginx).
BACKUP_APP_URL=http://app:8080
GITHUB_REPO_URL=https://github.com/your-org/knowledgeos-backups.git
GITHUB_TOKEN=ghp_changeme
GITHUB_BRANCH=backup
BACKUPS_KEEP=30
SCHEDULE_CRON=0 3 * * *
HTTP_TIMEOUT_SECONDS=600
