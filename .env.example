# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=knowledgeos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=knowledgeos

# App
APP_PROFILE=local
JWT_SECRET=changeme-jwt-secret-at-least-32-chars
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme
LOG_LEVEL=info
LOG_FORMAT=json

# Bot / YandexGPT
# Generate a 32-byte key, for example:
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
YANDEX_ENDPOINT=https://ai.api.cloud.yandex.net/v1
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_DEFAULT_CHAT_MODEL_LITE=
YANDEX_DEFAULT_CHAT_MODEL_PRO=
YANDEX_EMBEDDING_DOC_MODEL=text-embeddings-v2-doc
YANDEX_EMBEDDING_QUERY_MODEL=text-embeddings-v2-query
YANDEX_TIMEOUT_SECONDS=30
YANDEX_MAX_RETRIES=3

# Chat debug: log system prompt and raw LLM responses to app logs (may contain PII).
# Writes at info level when enabled. Do not enable in production.
BOT_CHAT_DEBUG_LOG=true

# RAG indexer / retriever
RAG_WORKER_ENABLED=true
RAG_WORKER_BATCH_SIZE=10
RAG_WORKER_POLL_INTERVAL_SECONDS=5
RAG_INDEX_MAX_ATTEMPTS=5
RAG_VECTOR_TOP_K=20
RAG_HYBRID_TOP_K=8

# Sync Agent (only needed with --profile sync)
CLOUD_API_URL=https://cloud.knowledgeos.example.com/api/v1
CLOUD_API_KEY=kos_live_changeme
SYNC_INTERVAL_SECONDS=60

# Backup snapshot endpoint (main app). Bearer key for GET /api/v1/backup/snapshot.
# Leave empty to disable the endpoint (returns 503). Rotate/revoke by changing
# this value — it is read per-request, no app restart required.
BACKUP_API_KEY=changeme
# Optional: commit hash baked into snapshot metadata. Set when building, e.g.
#   GIT_COMMIT=$(git rev-parse HEAD) docker compose up --build -d
GIT_COMMIT=

# CI/CD image-based deploy. GitHub Actions updates .env.images on the server
# before running docker compose pull/up. Keep runtime settings in server .env.
IMAGE_TAG=local
FRONTEND_IMAGE=ghcr.io/servicecraft/knowledgeos/frontend:local
BACKEND_IMAGE=ghcr.io/servicecraft/knowledgeos/backend:local
BACKUP_IMAGE=ghcr.io/servicecraft/knowledgeos/backup-service:local
FRONTEND_PORT=8080

# Backup service (only needed with --profile backup, or when deployed standalone)
# APP_URL must point at the app over HTTPS in production (TLS terminated by Nginx).
BACKUP_APP_URL=http://app:8080
GITHUB_REPO_URL=https://github.com/your-org/knowledgeos-backups.git
GITHUB_TOKEN=ghp_changeme
GITHUB_BRANCH=backup
BACKUPS_KEEP=30
SCHEDULE_CRON=0 3 * * *
HTTP_TIMEOUT_SECONDS=600

MAX_INSECURE_SKIP_VERIFY=true
