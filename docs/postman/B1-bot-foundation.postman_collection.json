                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('telegram secret is marked as set', function () {",
                  "  pm.expect(json.data.kind).to.eql('telegram');",
                  "  pm.expect(json.data.is_set).to.eql(true);",
                  "});",
                  "pm.test('does not expose telegram token', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('123456:test-telegram-token');",
                  "});"
                ]
              }
            }
          ]
        },
