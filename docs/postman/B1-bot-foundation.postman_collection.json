    {
      "name": "02 Tenant Secrets",
      "item": [
        {
          "name": "List Secret Statuses",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Company-ID",
                "value": "{{companyId}}",
                "description": "Optional: useful for superadmin tenant switching. Remove/disable if not needed."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/bot/secrets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bot",
                "secrets"
              ]
            },
            "description": "Lists status for supported secret kinds. Response must not include plaintext values."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns secret statuses', function () {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  const kinds = json.data.map(s => s.kind);",
                  "  pm.expect(kinds).to.include('llm');",
                  "  pm.expect(kinds).to.include('telegram');",
                  "});",
                  "pm.test('does not expose plaintext secret', function () {",
                  "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('llmSecret'));",
                  "  pm.expect(pm.response.text()).to.not.include('ciphertext');",
                  "  pm.expect(pm.response.text()).to.not.include('nonce');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Set LLM Secret",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Company-ID",
                "value": "{{companyId}}",
                "description": "Optional: useful for superadmin tenant switching. Remove/disable if not needed."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"{{llmSecret}}\",\n  \"metadata\": {\n    \"auth_type\": \"{{secretAuthType}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/bot/secrets/llm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bot",
                "secrets",
                "llm"
              ]
            },
            "description": "Stores encrypted LLM secret for the current tenant. Requires `SECRETS_ENCRYPTION_KEY` on backend. `secretAuthType` can be `iam` or `api_key`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('llm secret is marked as set', function () {",
                  "  pm.expect(json.data.kind).to.eql('llm');",
                  "  pm.expect(json.data.is_set).to.eql(true);",
                  "  pm.expect(json.data.metadata.auth_type).to.eql(pm.collectionVariables.get('secretAuthType'));",
                  "});",
                  "pm.test('does not expose plaintext secret', function () {",
                  "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('llmSecret'));",
                  "  pm.expect(pm.response.text()).to.not.include('ciphertext');",
                  "  pm.expect(pm.response.text()).to.not.include('nonce');",
                  "});"
                ]
              }
            }
          ]
        },
