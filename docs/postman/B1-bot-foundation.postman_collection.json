    },
    {
      "name": "03 Acceptance Checks",
      "item": [
        {
          "name": "Acceptance - Settings And Secret Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Company-ID",
                "value": "{{companyId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/bot/secrets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bot",
                "secrets"
              ]
            },
            "description": "Acceptance check for criteria: tenant secrets are scoped to company and API response never exposes plaintext/ciphertext/nonce. Run after setting LLM secret if you expect `llm.is_set=true`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('all secret statuses are safe to expose', function () {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  json.data.forEach((s) => {",
                  "    pm.expect(s).to.not.have.property('value');",
                  "    pm.expect(s).to.not.have.property('ciphertext');",
                  "    pm.expect(s).to.not.have.property('nonce');",
                  "  });",
                  "});",
                  "pm.test('plaintext secret is not in response body', function () {",
                  "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('llmSecret'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Acceptance - Unauthorized Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/bot/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bot",
                "settings"
              ]
            },
            "description": "Protected bot settings endpoint must require JWT auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    }
