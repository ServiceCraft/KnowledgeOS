            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"123456:test-telegram-token\",\n  \"metadata\": {\n    \"bot_username\": \"knowledgeos_test_bot\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/bot/secrets/telegram",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
