                "settings"
              ]
            },
            "description": "Manual check for switching Lite/Pro and model override. Replace model URI with a real Yandex folder/model URI before production testing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('settings updated to pro with model', function () {",
                  "  pm.expect(json.data.model_tier).to.eql('pro');",
