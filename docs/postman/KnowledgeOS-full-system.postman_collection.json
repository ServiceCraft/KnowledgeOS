{
  "info": {
    "_postman_id": "1d7c0f6b-5cf9-4f46-9a3d-knowledgeos-full-system",
    "name": "KnowledgeOS Full System API",
    "description": "Full manual API collection for the current KnowledgeOS backend: auth, knowledge base, comments, links, search, sync status, admin, import/export, backup, sync API-key routes, and B1 bot foundation endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "email", "value": "admin@example.com", "type": "string" },
    { "key": "password", "value": "changeme", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "companyAdminEmail", "value": "company-admin-{{$timestamp}}@example.com", "type": "string" },
    { "key": "newUserEmail", "value": "editor-{{$timestamp}}@example.com", "type": "string" },
    { "key": "newUserPassword", "value": "password123", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "themeId", "value": "", "type": "string" },
    { "key": "qaId", "value": "", "type": "string" },
    { "key": "articleId", "value": "", "type": "string" },
    { "key": "pricingCategoryId", "value": "", "type": "string" },
    { "key": "pricingServiceId", "value": "", "type": "string" },
    { "key": "commentId", "value": "", "type": "string" },
    { "key": "linkId", "value": "", "type": "string" },
    { "key": "callId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "syncApiKey", "value": "kos_live_changeme", "type": "string" },
    { "key": "backupApiKey", "value": "changeme", "type": "string" },
    { "key": "llmSecret", "value": "test-iam-token", "type": "string" },
    { "key": "secretAuthType", "value": "iam", "type": "string" }
  ],
  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.collectionVariables.set('accessToken', d.access_token);",
              "pm.collectionVariables.set('refreshToken', d.refresh_token);",
              "if (d.user && d.user.company_id) pm.collectionVariables.set('companyId', d.user.company_id);"
            ] }
          }]
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.collectionVariables.set('accessToken', d.access_token);",
              "pm.collectionVariables.set('refreshToken', d.refresh_token);"
            ] }
          }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
