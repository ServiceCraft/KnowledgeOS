          "request": { "method": "GET", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }], "url": "{{baseUrl}}/admin/bot/secrets" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('no plaintext/cipher internals', () => { const txt = pm.response.text(); pm.expect(txt).to.not.include(pm.collectionVariables.get('llmSecret')); pm.expect(txt).to.not.include('ciphertext'); pm.expect(txt).to.not.include('nonce'); });"
          ] } }]
        },
        {
          "name": "Set LLM Secret",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"value\": \"{{llmSecret}}\",\n  \"metadata\": { \"auth_type\": \"{{secretAuthType}}\" }\n}" },
            "url": "{{baseUrl}}/admin/bot/secrets/llm"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK or 400 if SECRETS_ENCRYPTION_KEY not configured', () => pm.expect([200,400]).to.include(pm.response.code));",
            "pm.test('does not expose secret', () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('llmSecret')));"
          ] } }]
        },
        {
          "name": "Delete LLM Secret",
          "request": { "method": "DELETE", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }], "url": "{{baseUrl}}/admin/bot/secrets/llm" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }]
        }
